# Kernel config fragment for the proxmox9 target.
#
# Merged on top of the linux-ps5 .config by docker/kernel-builder/build.sh
# when this distro is built. Only mainline options, and no PS5 platform option
# is touched. Almost everything is a loadable module or a switch inside a
# module; the only change to the kernel image itself is NET_CLS_ACT (traffic
# control actions, section 3) and the NETFILTER_SKIP_EGRESS helper it pulls in.
# The build fails if one of these lines does not end up in the final .config,
# so a typo or an unmet dependency cannot go unnoticed.

# --- 1. Proxmox firewall (pve-firewall) --------------------------------------
# pve-firewall switches the host to iptables-legacy / ebtables-legacy every
# time it starts, so it needs the legacy tables, not only nftables.
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=m
CONFIG_IP_NF_FILTER=m
CONFIG_IP_NF_MANGLE=m
CONFIG_IP_NF_RAW=m
CONFIG_IP_NF_NAT=m
CONFIG_IP6_NF_IPTABLES_LEGACY=m
CONFIG_IP6_NF_FILTER=m
CONFIG_IP6_NF_MANGLE=m
CONFIG_IP6_NF_RAW=m
CONFIG_IP6_NF_NAT=m
CONFIG_BRIDGE_NF_EBTABLES_LEGACY=m
CONFIG_BRIDGE_EBT_BROUTE=m
CONFIG_BRIDGE_EBT_T_FILTER=m
CONFIG_BRIDGE_EBT_T_NAT=m
# ebtables matches and targets (MAC and IP filter of guests)
CONFIG_BRIDGE_EBT_802_3=m
CONFIG_BRIDGE_EBT_AMONG=m
CONFIG_BRIDGE_EBT_ARP=m
CONFIG_BRIDGE_EBT_IP=m
CONFIG_BRIDGE_EBT_IP6=m
CONFIG_BRIDGE_EBT_LIMIT=m
CONFIG_BRIDGE_EBT_MARK=m
CONFIG_BRIDGE_EBT_PKTTYPE=m
CONFIG_BRIDGE_EBT_STP=m
CONFIG_BRIDGE_EBT_VLAN=m
CONFIG_BRIDGE_EBT_ARPREPLY=m
CONFIG_BRIDGE_EBT_DNAT=m
CONFIG_BRIDGE_EBT_MARK_T=m
CONFIG_BRIDGE_EBT_REDIRECT=m
CONFIG_BRIDGE_EBT_SNAT=m
CONFIG_BRIDGE_EBT_LOG=m
CONFIG_BRIDGE_EBT_NFLOG=m
# ipset: pve-firewall keeps its address lists (IP sets, management network,
# blacklist) in hash:net sets and matches them with "-m set".
CONFIG_IP_SET=m
CONFIG_IP_SET_HASH_IP=m
CONFIG_IP_SET_HASH_IPPORT=m
CONFIG_IP_SET_HASH_NET=m
CONFIG_IP_SET_HASH_NETPORT=m
CONFIG_IP_SET_HASH_NETIFACE=m
CONFIG_IP_SET_LIST_SET=m
CONFIG_NETFILTER_XT_SET=m
# MSS clamping, used by some SDN / PPPoE setups
CONFIG_NETFILTER_XT_TARGET_TCPMSS=m
# nftables-based proxmox-firewall (opt-in in PVE 9): bridge metadata matches
CONFIG_NFT_BRIDGE_META=m

# --- 2. VLANs ----------------------------------------------------------------
# 802.1Q interfaces (vmbr0.10, tagged guest NICs) and VLAN-aware bridges.
CONFIG_VLAN_8021Q=m
CONFIG_BRIDGE_VLAN_FILTERING=y

# --- 3. Rate limit on guest network devices ----------------------------------
# qemu-server / pve-container shape with: htb (egress), ingress + basic filter
# + police action (ingress).
CONFIG_NET_CLS_ACT=y
CONFIG_NET_SCH_HTB=m
CONFIG_NET_SCH_INGRESS=m
CONFIG_NET_CLS_BASIC=m
CONFIG_NET_CLS_U32=m
CONFIG_NET_ACT_POLICE=m

# --- 4. LVM-thin and LVM snapshots -------------------------------------------
CONFIG_DM_THIN_PROVISIONING=m
CONFIG_DM_SNAPSHOT=m

# --- 5. Shared storage clients (useful once the node joins a cluster) --------
# iSCSI initiator (open-iscsi is already installed in the image)
CONFIG_SCSI_LOWLEVEL=y
CONFIG_ISCSI_TCP=m
# Ceph: kernel RBD (containers on RBD, krbd) and CephFS
CONFIG_CEPH_LIB=m
CONFIG_BLK_DEV_RBD=m
CONFIG_CEPH_FS=m
